<?xml version="1.0" encoding="utf-8"?>
<!--
  group_bg — DESIGN SYSTEM (Cockpit L2) · @style/Cockpit.Group background. Matches the mockup `.group`
  (docs/specs/ui-visual-upgrade-l2.html): a diagonal-vertical gradient surface_2(top)→surface(bottom), a
  1px @color/hairline stroke and 20dp corners, plus a faint 1px top highlight for depth. The soft drop
  shadow comes from android:elevation on the style (this drawable only paints the face). New drawable.
  NOTE: Android <gradient> angle must be a multiple of 45 (270 = top→bottom, closest to the mockup 170deg).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base group face: vertical gradient + hairline stroke + rounded corners -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/surface_2"
                android:endColor="@color/surface" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="@color/hairline" />
        </shape>
    </item>
    <!-- Faint top highlight (subtle sheen along the top edge) -->
    <item android:gravity="top" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_highlight" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
