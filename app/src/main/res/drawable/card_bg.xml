<?xml version="1.0" encoding="utf-8"?>
<!--
  card_bg — DARK cockpit card (L2 Stage 1). Same resource name (layouts auto-reskin).
  Vertical gradient surface_2 (top) -> surface (bottom), 1dp hairline stroke, ~20dp corners,
  plus a faint 1.5dp top highlight for depth. layer-list of <shape>s.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base card: vertical gradient + hairline stroke + rounded corners -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/surface_2"
                android:endColor="@color/surface" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="@color/hairline_strong" />
        </shape>
    </item>
    <!-- Faint top highlight (subtle sheen along the top edge) -->
    <item android:gravity="top" android:height="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_highlight" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
