<?xml version="1.0" encoding="utf-8"?>
<!--
  hero_card_bg — DESIGN SYSTEM (Cockpit L2) · @style/Cockpit.HeroCard background. Matches the mockup `.hcard`
  (docs/specs/ui-visual-upgrade-l2.html): a diagonal gradient surface_2→surface, a 1px @color/hairline
  stroke, 20dp corners and a 1px inset light top-highlight line for the "glass" depth. The soft shadow
  comes from android:elevation on the style. New drawable.
  NOTE: Android <gradient> angle must be a multiple of 45 (315 ≈ the mockup's 160deg diagonal; 300 is not
  a legal Android gradient angle so the nearest legal diagonal is used).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base hero face: diagonal gradient + hairline stroke + rounded corners -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="@color/surface_2"
                android:endColor="@color/surface" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="@color/hairline" />
        </shape>
    </item>
    <!-- 1px inset top highlight line (light sheen) -->
    <item android:gravity="top" android:height="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_highlight" />
        </shape>
    </item>
</layer-list>
